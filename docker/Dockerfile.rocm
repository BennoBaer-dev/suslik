# suslik rocm (N2, TESTPHASE): AMD-GPUs via onnxruntime-MIGraphX. Faktenbasis
# Recherche-Stand (Primaerquellen, 2026-07): ROCm-EP ist seit ORT 1.23
# ENTFERNT — MIGraphX ist AMDs vorgesehener Weg; Wheel = PyPI onnxruntime-migraphx
# 1.27.1 (einziges cp313-faehige, ELF-geprueft: braucht libmigraphx_c.so.3 +
# libamdhip64.so.7 unter /opt/rocm-7.2.4). AMD liefert KEINE Debian-Pakete ->
# Ubuntu-noble-Builder-Stage + selektives Lib-Kopieren (Frigates -rocm-Muster).
# HSA_OVERRIDE_GFX_VERSION wird NICHT eingebacken (Quellen widerspruechlich; Config/
# Env-Knopf des Nutzers). Erst-Tester: Radeon 780M/gfx1103 — offiziell erst ab einer
# noch unveroeffentlichten ROCm-Version, MIGraphX-JIT ist die Hoffnung; genau das
# klaert der Test. Geraete kommen per compose (/dev/kfd + /dev/dri).
#
# HERKUNFT DES FIXES (Befund 08.09.2026 am gebauten .510-rocm-Image, Anlass PR #28
# eines Erst-Testers mit RDNA3-Karte): das selektive Buendel war UNVOLLSTAENDIG —
# librocprofiler-register.so.0 (Abhaengigkeit von libamdhip64/libMIOpen/librocblas UND
# von libonnxruntime_providers_migraphx.so) und libroctx64.so.4 fehlten, ausserdem die
# HIP-Header. Folge: der MIGraphX-Provider war nicht ladbar, das Image rechnete fuer
# JEDEN Nutzer auf der CPU — lautlos, weil face_audit.py auf CPU zurueckfaellt. Seit
# .511 sind beide Libs + include/ dabei, und eine Build-Zeit-Selbstpruefung unten macht
# genau diese Fehlerklasse ("fehlende Shared Library im Image") sofort rot.
FROM ubuntu:24.04 AS rocm-builder
ARG ROCM=7.2.4
RUN apt-get update && apt-get install -y --no-install-recommends wget ca-certificates \
    && wget -q https://repo.radeon.com/amdgpu-install/7.2.4/ubuntu/noble/amdgpu-install_7.2.4.70204-1_all.deb \
    && apt-get install -y ./amdgpu-install_7.2.4.70204-1_all.deb \
    && apt-get update && apt-get install -y --no-install-recommends \
       hip-runtime-amd migraphx miopen-hip rocblas rocminfo \
       rocprofiler-register roctracer hip-dev \
    && rm -rf /var/lib/apt/lists/*
# rocprofiler-register/roctracer/hip-dev sind HEUTE schon Abhaengigkeiten der Zeile
# darueber (rocprofiler-register von hip-runtime-amd, roctracer von miopen-hip, hip-dev
# von migraphx) — sie stehen trotzdem NAMENTLICH da, weil das Buendel unten genau ihre
# Dateien braucht. Aendert AMD die Abhaengigkeitskette, faellt hier apt aus und nicht
# erst beim Nutzer der Provider.
# Selektiv buendeln (Frigate-Muster): Kern-Libs + NUR gfx10/11/12-Kernel-Dateien
RUN mkdir -p /opt/rocm-dist/opt/rocm-$ROCM/lib/migraphx/lib \
             /opt/rocm-dist/opt/rocm-$ROCM/lib/rocblas/library \
             /opt/rocm-dist/opt/rocm-$ROCM/share/miopen/db \
             /opt/rocm-dist/opt/rocm-$ROCM/bin /opt/rocm-dist/etc/ld.so.conf.d \
    && cd /opt/rocm-$ROCM/lib \
    && cp -dpr libMIOpen*.so* libamd*.so* libhip*.so* libhsa*.so* libmigraphx*.so* \
               librocm*.so* librocblas*.so* librocroller*.so* \
               librocprofiler-register.so* libroctx64.so* \
               /opt/rocm-dist/opt/rocm-$ROCM/lib/ 2>/dev/null; \
    rm -f /opt/rocm-dist/opt/rocm-$ROCM/lib/libmigraphx_py*.so*; \
    cd /opt/rocm-$ROCM/lib && cp -dpr migraphx/lib/* /opt/rocm-dist/opt/rocm-$ROCM/lib/migraphx/lib/ \
    && (cp -dpr rocblas/library/*gfx10* rocblas/library/*gfx11* rocblas/library/*gfx12* \
        /opt/rocm-dist/opt/rocm-$ROCM/lib/rocblas/library/ 2>/dev/null || true) \
    && (cp -dpr /opt/rocm-$ROCM/share/miopen/db/*gfx10* /opt/rocm-$ROCM/share/miopen/db/*gfx11* \
        /opt/rocm-$ROCM/share/miopen/db/*gfx12* /opt/rocm-dist/opt/rocm-$ROCM/share/miopen/db/ 2>/dev/null || true) \
    && cp -dpr /opt/rocm-$ROCM/bin/rocminfo /opt/rocm-dist/opt/rocm-$ROCM/bin/ \
    && cp -dpr /opt/rocm-$ROCM/include /opt/rocm-dist/opt/rocm-$ROCM/include \
    && du -sh /opt/rocm-dist/opt/rocm-$ROCM/include \
    && ln -s rocm-$ROCM /opt/rocm-dist/opt/rocm \
    && echo /opt/rocm/lib > /opt/rocm-dist/etc/ld.so.conf.d/rocm.conf
# Zu den drei Aenderungen im Block darueber (.511):
#  - librocprofiler-register.so* + libroctx64.so*: die zwei Muster, die im Buendel
#    fehlten (Befund 08.09., s. Kopf). Ohne sie ist der MIGraphX-Provider tot.
#  - libmigraphx_py*: BEWUSST wieder entfernt statt das Muster libmigraphx*.so* zu
#    verengen. Es sind die Python-Bindings der MIGraphX-Bibliothek (_3.12 fuer den
#    Ubuntu-Builder, _3.13 fuer dieses Image) — suslik ruft MIGraphX ausschliesslich
#    ueber den onnxruntime-EP, nie ueber deren Python-API. Ein negatives Glob gibt es
#    in sh nicht; ein verengtes Positiv-Muster muesste jede kuenftige libmigraphx_*
#    einzeln aufzaehlen und wuerde beim naechsten ROCm-Sprung still etwas verlieren.
#    Das `rm -f` sagt dagegen genau, was hier NICHT mitfaehrt. Nebenbei faellt damit
#    die _3.12-Datei weg, deren libpython3.12.so.1.0 in diesem Image nie existiert.
#  - include/: die HIP-Header. Laut PR-#28-Tester braucht der hiprtc-JIT sie zur
#    Laufzeit, wenn MIGraphX Kernel fuer eine Karte uebersetzt, fuer die keine
#    vorkompilierten Bibliotheken vorliegen (genau der RDNA3-Fall). Hier nicht
#    nachpruefbar — diese Maschine hat keine AMD-Karte; die Groesse steht per du im
#    Build-Log.

FROM python:3.13-slim-trixie
# Basis wie cpu-Image + AMD-Media (mesa) + libnuma (ROCm-Laufzeitbedarf laut Frigate)
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg libgl1 libglib2.0-0 ca-certificates wget \
        mesa-va-drivers libnuma1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=rocm-builder /opt/rocm-dist/ /
RUN ldconfig

WORKDIR /app
COPY docker/requirements.gpu.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt \
    && pip uninstall -y onnxruntime onnxruntime-openvino \
    && pip install --no-cache-dir --no-deps onnxruntime-migraphx==1.27.1

# BUILD-ZEIT-SELBSTPRUEFUNG (.511, aus dem Befund im Kopf): jede mitgelieferte
# Shared Library muss IM IMAGE aufloesbar sein. Genau das war .510 nicht — und
# gemerkt haette es niemand, denn onnxruntime.get_available_providers() nennt
# 'MIGraphXExecutionProvider' auch dann, wenn dessen .so gar nicht ladbar ist
# (nachgemessen am .510-Image). Die Provider-Liste ist also KEIN Beweis; ldd ist einer.
# Fail-closed: ein einziges "not found" bricht den Build ab, mit Datei und Lib im
# Klartext. Der ORT-Pfad wird aus dem Paket ERMITTELT (importlib.util.find_spec,
# ohne das Modul zu importieren), nicht als Pfad-Literal geraten. Kein Pipe traegt
# hier ein Urteil: gewertet wird der Inhalt, der Exit kommt aus dem expliziten exit 1.
RUN set -eu; \
    ORT_DIR="$(python -c 'import importlib.util, os; print(os.path.dirname(importlib.util.find_spec("onnxruntime").origin))')"; \
    fehler=0; geprueft=0; \
    for so in $(find "$ORT_DIR" /opt/rocm/lib -name '*.so*' -type f); do \
      geprueft=$((geprueft+1)); \
      fehlend="$(ldd "$so" 2>/dev/null | awk '/not found/ {print $1}' | sort -u | tr '\n' ' ')"; \
      if [ -n "$fehlend" ]; then \
        echo "LDD-FEHLER: $so vermisst: $fehlend" >&2; \
        fehler=$((fehler+1)); \
      fi; \
    done; \
    if [ "$geprueft" -lt 10 ]; then \
      echo "ABBRUCH: nur $geprueft .so-Datei(en) gefunden — das Buendel fehlt, die Pruefung waere ein leeres Versprechen." >&2; exit 1; \
    fi; \
    if [ "$fehler" -gt 0 ]; then \
      echo "ABBRUCH: $fehler Datei(en) mit fehlender Shared Library (s.o.). Das Image wuerde beim Nutzer still auf die CPU zurueckfallen." >&2; exit 1; \
    fi; \
    echo "ldd-Selbstpruefung: $geprueft .so-Dateien, alle Abhaengigkeiten aufloesbar"

# MIGraphX-Workarounds wie Frigates AUSGELIEFERTES 0.17.2-rocm (die vier Schalter);
# Compile-Caches ins Volume (Warmup-Lehre P4: Kompilate muessen Neustarts ueberleben).
ENV MIGRAPHX_DISABLE_MIOPEN_FUSION=1 \
    MIGRAPHX_DISABLE_SCHEDULE_PASS=1 \
    MIGRAPHX_DISABLE_REDUCE_FUSION=1 \
    MIGRAPHX_ENABLE_HIPRTC_WORKAROUNDS=1 \
    MIOPEN_CUSTOM_CACHE_DIR=/data/clips/migraphx_cache \
    MIOPEN_USER_DB_PATH=/data/clips/migraphx_cache \
    AMD_COMGR_CACHE=1 \
    AMD_COMGR_CACHE_DIR=/data/clips/migraphx_cache
# Suchpfad fuer die HIP-Header (Angabe des PR-#28-Testers): hiprtc uebersetzt Kernel
# zur Laufzeit und findet die Header sonst nicht. Auf DIESER Maschine nicht pruefbar
# (keine AMD-Karte) — uebernommen, weil es ohne Karte nichts kostet und der einzige
# Beweis vom Feld kommt.
ENV C_INCLUDE_PATH=/opt/rocm/include \
    CPLUS_INCLUDE_PATH=/opt/rocm/include

COPY NOTICE LICENSE /app/
COPY models/ /app/models/
COPY docker/buffalo_l/ /root/.insightface/models/buffalo_l/
COPY verifyd.py analyze.py anlernen.py face_audit.py abnahme.py auftritte.py szenarien.py decode.py worker.py no_person.py sync_refs.py /app/
COPY webui/ /app/webui/
COPY core/ /app/core/
COPY routes/ /app/routes/
# PE1 Person-Learn (stufe2.md B5): bereinigte Prototyp-Kette + Modelle;
# Pfad-Bruecken via ENV (SUSLIK_DATA_DIR/SUSLIK_WERKSTATT).
COPY docker/personlern_stage/ /app/prototyp/
COPY docker/personlern_stage_modelle/ /app/prototyp/modelle/rtmpose/
COPY modelle/dinov2_vits14_126x252.onnx /app/modelle/
# .203: Person-ReID-Backbone (Intel OMZ 0277, Apache-2.0 inkl. Modelldatei; Bezug/Checksumme: core/personmodell.py BACKBONES + wiki/erkennung.md)
COPY modelle/person-reidentification-retail-0265.onnx /app/modelle/
ENV SUSLIK_DATA_DIR=/data SUSLIK_WERKSTATT=/data/personlern/werkstatt VERIFY_DATA_DIR=/data
COPY VERSION /app/VERSION
COPY docker/verifyd.container.rocm.yaml /app/verifyd.yaml

ARG VERSION=dev
ENV SUSLIK_VERSION=$VERSION SUSLIK_VARIANT=rocm
LABEL org.opencontainers.image.title="suslik" org.opencontainers.image.version="$VERSION" org.opencontainers.image.source="https://github.com/BennoBaer-dev/suslik"

EXPOSE 8199
CMD ["python", "verifyd.py", "--config", "verifyd.yaml"]
