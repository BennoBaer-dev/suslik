# suslik gpu-legacy: OpenVINO auf Intel-iGPUs der Generationen Gen8/Gen9/Gen11 (UHD 6xx, Core
# 6.-10. Gen; Anlass Issue #6: UHD 630 / 0x9BC8 auf i5-10500T). Intel liefert diese Generationen
# seit compute-runtime 24.35.30872.22 NUR noch ueber legacy1-Pakete (Mainline-Runtime = Gen12+,
# s. documentation/LEGACY_PLATFORMS.md im intel/compute-runtime-Repo) — das normale gpu-Image
# (26.27) kann sie deshalb nicht binden, waehrend VAAPI (getrennter Media-Stack) dort weiter geht.
# Stichtag 2026-07-28: legacy1 24.35.30872.36 (letztes Legacy-Release, Branch releases/24.35;
# neuere Tags .40-.45 existieren dort ohne gebaute .debs) + IGC 1.0.17537.24 (exakte
# Depends-Bindung `intel-igc-opencl (= 1.0.17537.24)` der legacy1-.debs — IGC 1.x, NICHT die
# 2.x-Pakete des gpu-Images) + libigdgmm12 22.5.0 (aus demselben Legacy-Release). 0x9BC8 steht
# im Legacy-Quellbaum als "Intel(R) UHD Graphics 630" (devices_base.inl, SUPPORT_CFL: Comet-Lake-
# Grafik laeuft bei Intel unter CFL/Gen9); OpenVINO 2025.4.1 (gebuendelt in onnxruntime-openvino
# 1.24.1) unterstuetzt Gen8+ im GPU-Plugin weiterhin. KEIN NPU-Block: Gen8/9/11-Systeme haben
# keine Intel-NPU (gibt es erst ab Meteor Lake) — damit entfallen auch libze1 + linux-npu-driver
# (OpenVINO-iGPU laeuft ueber OpenCL, nicht level-zero). Geraete kommen per compose.
FROM python:3.13-slim-trixie

# --- Basis wie gpu-Image, ohne libze1 (hing nur an den NPU-.debs). Beide VAAPI-Treiber bleiben:
#     iHD (Gen8+) + i965 (Gen7.5 und aelter) — Transcode-Stack, auf Gen9 unveraendert nutzbar
#     (Beleg Issue #6: Encode-Probe bestand dort trotz Compute-Runtime-Problem). ---
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg libgl1 libglib2.0-0 ca-certificates wget \
        ocl-icd-libopencl1 intel-media-va-driver i965-va-driver \
    && rm -rf /var/lib/apt/lists/*

# --- Intel iGPU-Runtime LEGACY: compute-runtime legacy1 24.35.30872.36 + IGC 1.0.17537.24.
#     Kein intel-level-zero-gpu-legacy1: der OpenVINO-iGPU-Pfad braucht nur OpenCL.
#     libigdgmm12 in der 22.10.0 aus dem MAINLINE-Release (wie Dockerfile.gpu), NICHT die 22.5.0
#     des Legacy-Releases: die 22.5.0 stufte Debians gmmlib herunter und brach die VAAPI-Encode-
#     Probe (Smoke-Test 28.07. auf 0.1.0.59); legacy1 verlangt nur >= 22.5.0, die 22.10.0 ist
#     mit trixies intel-media-va-driver auf dieser Maschine bewiesen. ---
ARG IGC=https://github.com/intel/intel-graphics-compiler/releases/download/igc-1.0.17537.24
ARG CR=https://github.com/intel/compute-runtime/releases/download/24.35.30872.36
ARG CRMAIN=https://github.com/intel/compute-runtime/releases/download/26.27.39122.11
RUN cd /tmp && for u in \
      $IGC/intel-igc-core_1.0.17537.24_amd64.deb \
      $IGC/intel-igc-opencl_1.0.17537.24_amd64.deb \
      $CRMAIN/libigdgmm12_22.10.0_amd64.deb \
      $CR/intel-opencl-icd-legacy1_24.35.30872.36_amd64.deb ; do wget -q "$u" ; done \
    && apt-get update \
    && (dpkg -i /tmp/*.deb || apt-get -f install -y) \
    && rm -rf /tmp/*.deb /var/lib/apt/lists/*

# --- Python-Deps: identisch zum gpu-Image (onnxruntime-openvino MUSS ueber plain onnxruntime
#     gewinnen, siehe requirements.gpu.txt + Kommentar im Dockerfile.gpu). ---
WORKDIR /app
COPY docker/requirements.gpu.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt \
    && pip uninstall -y onnxruntime onnxruntime-openvino \
    && pip install --no-cache-dir --no-deps onnxruntime-openvino==1.24.1

# --- Modelle backen + Code + Container-Config (identisch zum gpu-Image; backend: auto loest
#     auf Gen9 ohne NPU nach openvino:GPU auf). ---
COPY NOTICE LICENSE /app/
COPY models/ /app/models/
COPY docker/buffalo_l/ /root/.insightface/models/buffalo_l/
COPY verifyd.py analyze.py anlernen.py face_audit.py abnahme.py auftritte.py szenarien.py decode.py worker.py no_person.py sync_refs.py /app/
COPY webui/ /app/webui/
COPY core/ /app/core/
COPY routes/ /app/routes/
# PE1 Person-Learn (stufe2.md B5): bereinigte Prototyp-Kette + Modelle;
# Pfad-Bruecken via ENV (SUSLIK_DATA_DIR/SUSLIK_WERKSTATT).
COPY docker/personlern_stage/ /app/prototyp/
COPY docker/personlern_stage_modelle/ /app/prototyp/modelle/rtmpose/
COPY modelle/dinov2_vits14_126x252.onnx /app/modelle/
ENV SUSLIK_DATA_DIR=/data SUSLIK_WERKSTATT=/data/personlern/werkstatt VERIFY_DATA_DIR=/data
COPY VERSION /app/VERSION
COPY docker/verifyd.container.gpu.yaml /app/verifyd.yaml

# Feste Versionsnummer ins Image (tools/build.sh reicht sie aus der VERSION-Datei als --build-arg rein).
ARG VERSION=dev
ENV SUSLIK_VERSION=$VERSION SUSLIK_VARIANT=gpu-legacy
LABEL org.opencontainers.image.title="suslik" org.opencontainers.image.version="$VERSION" org.opencontainers.image.source="https://github.com/BennoBaer-dev/suslik"

EXPOSE 8199
CMD ["python", "verifyd.py", "--config", "verifyd.yaml"]
