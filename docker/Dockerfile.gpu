# suslik Stufe-2-Image: OpenVINO auf iGPU + NPU, mit AKTUELLEN Intel-Treibern (breite Hardware-Abdeckung
# fuer die Verteilung). Stichtag 2026-07-22: compute-runtime 26.27.39122.11, IGC 2.38.2, libigdgmm 22.10.0,
# linux-npu-driver 1.33.0 (level-zero-Loader bleibt Debians libze1). Intels Runtime ist ueber GPU-Gen. abwaerts-
# kompatibel -> neuer deckt mehr Kunden-Hardware ab. Kompatibilitaets-Anker ist der HOST-KERNEL
# (i915/xe + intel_vpu), gegen den die Container-Runtime laeuft; wird auf dem Zielhost getestet.
# (Erst-Beweis lief mit Host-Match 25.35 / NPU 1.28; jetzt hochgezogen.) Geraete kommen per compose.
FROM python:3.13-slim-trixie

# --- Basis-Runtime + OpenCL-Loader + level-zero-Loader aus Debian 13 (libze1, ocl-icd). Debians libze1
#     ist das Paket, an dem die NPU-.debs per NAME haengen; ein fremdes 'level-zero'-Paket kollidiert.
#     intel-media-va-driver (iHD, Debian main/frei): VAAPI-MEDIA-Treiber fuer ffmpeg h264_vaapi — die
#     Compute-Runtime unten ist ein GETRENNTER Stack und deckt Transcode nicht ab. Ohne dieses Paket
#     traegt das Image nur libva und JEDER Clip-Transcode faellt still auf libx264/CPU zurueck
#     (Tester-Issue 26.07.; free-Variante reicht: Encode-Probe rc=0 auf Meteor-Lake-iGPU gemessen).
#     i965-va-driver dazu (1,8 MB, main): deckt Gen7.5/Haswell und aelter ab, die iHD (Gen8+) nicht
#     kann — Ziel dieses Images ist breite Hardware-Abdeckung; Frigate liefert aus demselben Grund
#     beide Treiber aus. video_encoder() probt zur Laufzeit, welcher greift. ---
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg libgl1 libglib2.0-0 ca-certificates wget \
        ocl-icd-libopencl1 libze1 intel-media-va-driver i965-va-driver \
    && rm -rf /var/lib/apt/lists/*

# --- Intel iGPU-Runtime AKTUELL: compute-runtime 26.27.39122.11 + IGC 2.38.2 (Loader = Debians libze1) ---
#     libigdgmm12 = Abhaengigkeit von intel-opencl-icd. OpenVINO-iGPU laeuft ueber OpenCL, nicht level-zero.
ARG IGC=https://github.com/intel/intel-graphics-compiler/releases/download/v2.38.2
ARG CR=https://github.com/intel/compute-runtime/releases/download/26.27.39122.11
RUN cd /tmp && for u in \
      $IGC/intel-igc-core-2_2.38.2+22051_amd64.deb \
      $IGC/intel-igc-opencl-2_2.38.2+22051_amd64.deb \
      $CR/libigdgmm12_22.10.0_amd64.deb \
      $CR/intel-opencl-icd_26.27.39122.11-0_amd64.deb \
      $CR/libze-intel-gpu1_26.27.39122.11-0_amd64.deb ; do wget -q "$u" ; done \
    && apt-get update \
    && (dpkg -i /tmp/*.deb || apt-get -f install -y) \
    && rm -rf /tmp/*.deb /var/lib/apt/lists/*

# --- Intel NPU-Treiber AKTUELL: linux-npu-driver 1.33.0 (ubuntu2404-Build; laeuft auf trixie) ---
#     Tarball: intel-driver-compiler-npu + intel-fw-npu + intel-level-zero-npu. Kernel-Treiber intel_vpu
#     kommt vom Host -> ob die neue NPU-Userspace mit dem Host-Kernel greift, wird im GPU+NPU-Test geprueft.
ARG NPU=https://github.com/intel/linux-npu-driver/releases/download/v1.33.0
# NACH /opt/npu entpacken, NICHT /tmp: tar wuerde beim Entpacken die Rechte von /tmp zuruecksetzen
# (weg von 1777), danach kann apts _apt-Sandbox dort keine Signatur-Tempfiles anlegen -> apt-get bricht.
RUN mkdir -p /opt/npu && cd /opt/npu \
    && wget -q $NPU/linux-npu-driver-v1.33.0.20260529-26625960453-ubuntu2404.tar.gz \
    && tar -xf linux-npu-driver-*.tar.gz \
    && apt-get update \
    && (dpkg -i $(find /opt/npu -name '*.deb') || apt-get -f install -y) \
    && rm -rf /opt/npu /var/lib/apt/lists/*

# --- Python-Deps: onnxruntime-openvino MUSS ueber plain onnxruntime gewinnen (insightface zieht plain
#     rein und verdeckt sonst die OpenVINO-EP) -> danach hart erzwingen. Siehe requirements.gpu.txt. ---
WORKDIR /app
COPY docker/requirements.gpu.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt \
    && pip uninstall -y onnxruntime onnxruntime-openvino \
    && pip install --no-cache-dir --no-deps onnxruntime-openvino==1.24.1

# --- S3: Intel-NEO-Kernel-Cache ins VOLUME. Muster ist Dockerfile.rocm (MIOPEN_CUSTOM_CACHE_DIR /
#     AMD_COMGR_CACHE_DIR -> /data/clips/migraphx_cache); clips/ ist vom Backup ausgeschlossen,
#     weil Kompilate regenerierbar sind.
#     FEHLERKLASSE: der NEO-Treiber legt seinen OpenCL-Kernel-Cache per Default unter
#     $HOME/.cache/neo_compiler_cache an (docker diff, 24.08.). Laeuft der Container mit
#     read-only Root, kann er dort nicht schreiben, und der Beschleuniger rechnet dann still
#     FALSCH und nicht reproduzierbar (gemessen: Norm-Abweichung 2,359/2,359/0,293 statt 0,000,
#     Norm 20,3 statt 26,07). Der Volume-Pfad schafft die Klasse ab, statt sie zu bewarnen.
#     Belegt am ausgelieferten Treiber: NEO_CACHE_DIR, NEO_CACHE_PERSISTENT und NEO_CACHE_MAX_SIZE
#     stehen als Strings in libigdrcl.so (26.27) und wirken real (Umleitung gemessen: .cl_cache-
#     Dateien landen im Zielordner, /root/.cache entsteht gar nicht erst).
#     Deckel 1 GiB: die zwei Norm-Kompilat-Blobs wiegen zusammen rund 252 MB, dazu kommen die
#     Embedder-Kompilate — 1 GiB laesst Luft fuer mehrere Modelle und deckelt das Volume trotzdem.
#     ACHTUNG: das Verzeichnis muss zur LAUFZEIT existieren. Fehlt es, legt der Treiber es NICHT
#     an, sondern schaltet den Cache still ab (gemessen 24.08.). /data ist ein Volume-Mount, ein
#     RUN mkdir hier waere davon verdeckt -> das Anlegen gehoert in den Dienststart (wie bei
#     clips/ov_cache). ---
ENV NEO_CACHE_DIR=/data/clips/neo_cache \
    NEO_CACHE_PERSISTENT=1 \
    NEO_CACHE_MAX_SIZE=1073741824

# --- Modelle backen + Code + Container-Config (wie Stufe 1) ---
COPY NOTICE LICENSE /app/
COPY models/ /app/models/
COPY docker/buffalo_l/ /root/.insightface/models/buffalo_l/
COPY verifyd.py analyze.py anlernen.py face_audit.py abnahme.py auftritte.py szenarien.py decode.py worker.py no_person.py sync_refs.py /app/
COPY webui/ /app/webui/
COPY core/ /app/core/
COPY routes/ /app/routes/
# PE1 Person-Learn (stufe2.md B5): bereinigte Prototyp-Kette + Modelle;
# Pfad-Bruecken: verify_data->/data (Deckung), prototyp/daten->Werkstatt im Volume.
COPY docker/personlern_stage/ /app/prototyp/
COPY docker/personlern_stage_modelle/ /app/prototyp/modelle/rtmpose/
COPY modelle/dinov2_vits14_126x252.onnx /app/modelle/
# .203: Person-ReID-Backbone (Intel OMZ 0277, Apache-2.0 inkl. Modelldatei; Bezug/Checksumme: core/personmodell.py BACKBONES + wiki/erkennung.md)
COPY modelle/person-reidentification-retail-0265.onnx /app/modelle/
ENV SUSLIK_DATA_DIR=/data SUSLIK_WERKSTATT=/data/personlern/werkstatt VERIFY_DATA_DIR=/data
COPY VERSION /app/VERSION
COPY docker/verifyd.container.gpu.yaml /app/verifyd.yaml

# Feste Versionsnummer ins Image (tools/build.sh reicht sie aus der VERSION-Datei als --build-arg rein).
ARG VERSION=dev
ENV SUSLIK_VERSION=$VERSION SUSLIK_VARIANT=gpu
LABEL org.opencontainers.image.title="suslik" org.opencontainers.image.version="$VERSION" org.opencontainers.image.source="https://github.com/BennoBaer-dev/suslik"

EXPOSE 8199
CMD ["python", "verifyd.py", "--config", "verifyd.yaml"]
